# Основная база. Схема и индексы создаются приложением при старте.
POSTGRES_URL=jdbc:postgresql://127.0.0.1:5432/ai_chat_app
POSTGRES_USER=chat
POSTGRES_PASSWORD=

# Нужен ТОЛЬКО одноразовой переливке MigrateMongoToPostgres, рантайму — нет
MONGODB_URI=mongodb://localhost:27017

GROQ_API_URL=https://api.groq.com/openai/v1/chat/completions
GROQ_API_KEY=
GROQ_MODEL=
USE_GROQ=false

OPEN_AI_API_URL=https://api.openai.com/v1/chat/completions
OPEN_AI_API_KEY=
OPEN_AI_MODEL=
USE_OPEN_AI=false

GEMINI_API_URL=https://generativelanguage.googleapis.com/v1beta/models
GEMINI_API_KEY=
GEMINI_MODEL=gemini-1.5-flash
USE_GEMINI=false

AI_TEMPERATURE=0.7
AI_PROMPT=
AI_GROUP_CHAT_PROMPT=

# Вход по почте и паролю. Включать ТОЛЬКО когда сервер за HTTPS:
# по http пароль идёт открытым текстом
EMAIL_AUTH_ENABLED=false
# Письма с кодами. Без ключа письма пишутся в лог сервера
RESEND_API_KEY=
MAIL_FROM=
APP_NAME=AI Chat

GOOGLE_OAUTH_TOKEN_INFO_URL=https://oauth2.googleapis.com/tokeninfo

AWS_ACCESS_KEY=
AWS_SECRET_KEY=
AWS_S3_BUCKET_NAME=
AWS_REGION=
